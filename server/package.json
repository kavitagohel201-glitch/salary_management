{
    "name":  "server",
    "version":  "1.0.0",
    "description":  "Express and PostgreSQL API",
    "main":  "index.js",
    "scripts":  {
                    "start":  "node index.js",
                    "dev":  "nodemon index.js",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate deploy",
                    "db:seed":  "node prisma/seed.js",
                    "test":  "node --test",
                    "test:vitest":  "vitest run vitest/employee.schema.vitest.js",
                    "db:reset-seed":  "node prisma/seed.js --reset"
                },
    "dependencies":  {
                         "@faker-js/faker":  "^9.9.0",
                         "@prisma/client":  "6.19.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "zod":  "^3.24.2"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.1.9",
                            "prisma":  "6.19.0",
                            "supertest":  "^7.1.1",
                            "vitest":  "^2.1.9"
                        }
}
